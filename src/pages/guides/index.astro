---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => data.type === 'complet')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Guides complets vidéosurveillance | GuideCaméras"
  description="Guides complets pour bien choisir, installer et configurer sa caméra de vidéosurveillance : emplacement, réseau, stockage et sécurité détaillés."
  wide
>
  <section class="hero">
    <h1>Guides complets</h1>
    <p>Des guides détaillés pour maîtriser votre installation de vidéosurveillance du choix à la configuration au quotidien.</p>
  </section>
  <div class="article-grid">
    {articles.map((entry) => <ArticleCard entry={entry} />)}
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => data.type === 'thematique')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Astuces & conseils vidéosurveillance | GuideCaméras"
  description="Astuces pratiques, idées et conseils thématiques autour de la vidéosurveillance et de la sécurité de la maison."
  wide
>
  <section class="hero">
    <h1>Astuces & conseils</h1>
    <p>Astuces d'installation, de réglages et conseils pratiques pour sécuriser votre domicile au quotidien.</p>
  </section>
  <div class="article-grid">
    {articles.map((entry) => <ArticleCard entry={entry} />)}
  </div>
</BaseLayout>
